---
import Base from './Base.astro';
import '@fontsource-variable/source-serif-4';
import Cta from '../components/Cta.astro';
import { t, localePath } from '../i18n/ui.js';
import { productNode, itemListNode } from '../data/products.js';
import { GUIDES } from '../data/guides.js';

const {
  title, description, lang = 'en', slug,
  cat, day, hero, heroAlt, updated = '2026-06-25',
  cluster = null,            // 'hosting' | 'deploy' → renders CTA; null = no CTA (reference)
  // Optional honest commerce schema (Product / SoftwareApplication / ItemList + Offer).
  // Shapes:
  //   { type: 'product', key: 'contabo', software: true, offers: true }  → single product/review
  //   { type: 'itemlist', name: '…', keys: ['contabo','hetzner',…] }      → comparison / best-of list
  // `offers: true` is HONEST ONLY when the price is visible in the page body (see products.js).
  commerce = null,
  // Optional FAQ: array of { q, a } - renders a visible FAQ section + FAQPage JSON-LD (GEO).
  faq = null,
  // Optional decision box shown BEFORE the hero and the affiliate block:
  // { items: [{ when: 'You want X', pick: 'Option', why: 'short reason' }] }
  choose = null,
  // Optional decision matrix shown INSTEAD of `choose`:
  // { caption: '…', head: ['Use','Solution','Upkeep','Check'], rows: [[…4 cells]], note: '…' }
  matrix = null,
  // Optional first-screen definition + 3 key facts, shown right under the header:
  // { def: '40-50 word definition', items: [{ k: 'label', v: 'short fact' }] }
  keyfacts = null,
  // Optional explanatory diagram shown INSTEAD of the hero photo (hero stays the share image):
  // { src: '/img/x.svg', srcMobile: '/img/x-mobile.svg', alt: '…', caption: '…' }
  diagram = null,
  // ctaTop=false: no affiliate card above the body (only the one after the content).
  ctaTop = true,
  // ctaBadge=false: card without the "Recommended" badge.
  ctaBadge = true,
} = Astro.props;

const path = `guides/${slug}`;
const url = 'https://html5advent.com' + localePath(lang, path);
const article = {
  '@type': 'TechArticle',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: updated,
  dateModified: updated,
  author: { '@type': 'Organization', name: 'HTML5 Advent' },
  /* publisher.logo est EXIGE par Google pour Article et ses derives. Il
     manquait sur les 257 guides du site, 10 URL sondees dans 6 langues, 10
     sans logo, donc aucun de ces guides ne pouvait obtenir de resultat
     enrichi. favicon.svg est la seule image de marque que le site serve:
     verifiee 200 avant d'etre ecrite ici, tandis que /og.png et /img/logo.png
     rendent 404. */
  publisher: {
    '@type': 'Organization',
    name: 'HTML5 Advent',
    url: 'https://html5advent.com',
    logo: { '@type': 'ImageObject', url: 'https://html5advent.com/favicon.svg' },
  },
  mainEntityOfPage: url,
  image: hero ? `https://html5advent.com${hero}` : undefined,
};

// Build honest commerce node(s) from the `commerce` prop. No rating is ever emitted.
let commerceNode = null;
if (commerce && commerce.type === 'product' && commerce.key) {
  commerceNode = productNode(commerce.key, {
    withOffers: commerce.offers === true,
    asSoftwareApplication: commerce.software === true,
  });
} else if (commerce && commerce.type === 'itemlist' && Array.isArray(commerce.keys)) {
  commerceNode = itemListNode(commerce.keys, commerce.name || title);
}

// Optional FAQPage node (GEO / rich result). Honest: only the Q&A actually shown in the page.
const faqNode = (Array.isArray(faq) && faq.length)
  ? { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
  : null;

// Emit a single JSON-LD: keep TechArticle, add commerce + FAQ via @graph when present.
const graph = [article, commerceNode, faqNode].filter(Boolean);
const schema = graph.length > 1
  ? { '@context': 'https://schema.org', '@graph': graph }
  : { '@context': 'https://schema.org', ...article };

// Stack guides open the VPS size calculator with their stack preselected (?stack=…).
const calcStack = /woocommerce/.test(slug) ? 'woocommerce'
  : /wordpress/.test(slug) ? 'wordpress'
  : /laravel|php/.test(slug) ? 'laravel'
  : /node|nextjs/.test(slug) ? 'node'
  : /static|astro/.test(slug) ? 'static'
  : null;

// Byline: who wrote it and when the facts were last checked (shown under the H1).
const BYLINE = {
  en: { by: 'By the HTML5 Advent editorial team', checked: 'Checked on', how: 'How we check' },
  fr: { by: 'Par la rédaction HTML5 Advent', checked: 'Vérifié le', how: 'Comment nous vérifions' },
  es: { by: 'Por la redacción de HTML5 Advent', checked: 'Verificado el', how: 'Cómo verificamos' },
  de: { by: 'Von der HTML5-Advent-Redaktion', checked: 'Geprüft am', how: 'Wie wir prüfen' },
  it: { by: 'Dalla redazione di HTML5 Advent', checked: 'Verificato il', how: 'Come verifichiamo' },
  pt: { by: 'Pela redação do HTML5 Advent', checked: 'Verificado em', how: 'Como verificamos' },
};
const byline = BYLINE[lang] || BYLINE.en;
const LOCALE_TAG = { en: 'en-GB', fr: 'fr-FR', es: 'es-ES', de: 'de-DE', it: 'it-IT', pt: 'pt-PT' };
const checkedLabel = new Date(updated + 'T12:00:00Z').toLocaleDateString(LOCALE_TAG[lang] || 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const CHOOSE_LABEL = { en: 'Which option to pick', fr: 'Quelle solution choisir', es: 'Qué opción elegir', de: 'Welche Lösung wählen', it: 'Quale soluzione scegliere', pt: 'Que solução escolher' };

const FAQ_LABEL = { en: 'Frequently asked questions', fr: 'Questions fréquentes', es: 'Preguntas frecuentes', de: 'Häufige Fragen', it: 'Domande frequenti', pt: 'Perguntas frequentes' };

// Related guides - internal links so every guide is cross-linked (crawl paths, not a dead end).
// Same category first, then fill with others; only guides that exist in this locale (no 404s).
const REL_LABEL = { en: 'Related guides', fr: 'Guides liés', es: 'Guías relacionadas', de: 'Verwandte Guides', it: 'Guide correlate', pt: 'Guias relacionados' };
const inLang = GUIDES.filter((g) => g.slug !== slug && (g.locales || ['en']).includes(lang));
const related = [...inLang.filter((g) => g.cat === cat), ...inLang.filter((g) => g.cat !== cat)].slice(0, 4);
---
<Base title={`${title} - HTML5 Advent`} description={description} lang={lang} path={path} schema={schema} ogType="article">
  <article class="article">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={localePath(lang)}>{t(lang, 'home')}</a> ›
      <a href={localePath(lang, 'guides')}>{t(lang, 'guides')}</a> ›
      <span>{title}</span>
    </nav>

    <header class="art-head">
      <p class="kicker">// {cat}{day ? ` · ${t(lang, 'advent')} #${day}` : ''}</p>
      <h1>{title}</h1>
      {!(keyfacts && keyfacts.def) && <p class="lede">{description}</p>}
      <p class="byline">{byline.by} · {byline.checked} <time datetime={updated}>{checkedLabel}</time> · <a href="/about#how-guides-are-written">{byline.how}</a></p>
    </header>

    {keyfacts && keyfacts.def && (
      <section class="keyfacts" data-keyfacts>
        <p class="keyfacts-def">{keyfacts.def}</p>
        {Array.isArray(keyfacts.items) && keyfacts.items.length > 0 && (
          <ul>
            {keyfacts.items.map((f) => (<li><strong>{f.k}</strong><span>{f.v}</span></li>))}
          </ul>
        )}
      </section>
    )}

    {matrix && Array.isArray(matrix.rows) && matrix.rows.length > 0 && (
      <section class="matrix" aria-labelledby="matrix-h" data-matrix>
        <h2 id="matrix-h">{matrix.title || CHOOSE_LABEL[lang] || CHOOSE_LABEL.en}</h2>
        <div class="matrix-scroll">
          <table>
            <thead><tr>{matrix.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {matrix.rows.map((r) => (
                <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td class={i === 1 ? 'matrix-pick' : ''} data-label={matrix.head[i]}>{c}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
        {matrix.note && <p class="matrix-note">{matrix.note}</p>}
      </section>
    )}

    {!matrix && choose && Array.isArray(choose.items) && choose.items.length > 0 && (
      <section class="choose" aria-labelledby="choose-h">
        <h2 id="choose-h">{CHOOSE_LABEL[lang] || CHOOSE_LABEL.en}</h2>
        <ul>
          {choose.items.map((c) => (
            <li><span class="choose-when">{c.when}</span><strong class="choose-pick">{c.pick}</strong>{c.why && <span class="choose-why">{c.why}</span>}</li>
          ))}
        </ul>
      </section>
    )}

    {diagram ? (
      <figure class="diagram">
        <picture>
          {diagram.srcMobile && <source media="(max-width: 600px)" srcset={diagram.srcMobile} />}
          <img src={diagram.src} alt={diagram.alt} width="720" height="330" loading="eager" />
        </picture>
        {diagram.caption && <figcaption>{diagram.caption}</figcaption>}
      </figure>
    ) : hero && <img class="hero-img" src={hero} alt={heroAlt} width="1280" height="720" loading="eager" />}

    {cluster && ctaTop && <Cta cluster={cluster} locale={lang} badge={ctaBadge} />}
    {cluster === 'hosting' && (
      <p class="calc-promo"><a href={localePath(lang, 'tools/vps-size-calculator') + (calcStack ? `?stack=${calcStack}` : '')}>{({
        en: 'Not sure how big your server should be? Try the free VPS size calculator',
        fr: 'Quelle taille de serveur choisir ? Essayez le calculateur de taille de VPS gratuit',
        es: '¿Qué tamaño de servidor necesitas? Prueba la calculadora de tamaño de VPS gratuita',
        de: 'Wie groß muss dein Server sein? Probier den kostenlosen VPS-Größenrechner',
        it: 'Quanto deve essere grande il tuo server? Prova il calcolatore dimensione VPS gratuito',
        pt: 'Que tamanho de servidor precisa? Experimente a calculadora de tamanho de VPS gratuita',
      })[lang] || 'Try the free VPS size calculator'} &rarr;</a></p>
    )}

    <div class="prose"><slot /></div>

    {cluster && <Cta cluster={cluster} locale={lang} badge={ctaBadge} />}

    {Array.isArray(faq) && faq.length > 0 && (
      <section class="faq" aria-label={FAQ_LABEL[lang] || FAQ_LABEL.en}>
        <h2>{FAQ_LABEL[lang] || FAQ_LABEL.en}</h2>
        <dl>
          {faq.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {related.length > 0 && (
      <aside class="related" aria-label={REL_LABEL[lang] || REL_LABEL.en}>
        <h2>{REL_LABEL[lang] || REL_LABEL.en}</h2>
        <ul>
          {related.map((g) => (
            <li><a href={localePath(lang, `guides/${g.slug}`)}>{(g.title && (g.title[lang] || g.title.en)) || g.slug}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </article>

  <style>
    .calc-promo { margin: -1rem 0 2rem; font-family: var(--mono); font-size: .9rem; }
    .calc-promo a { color: var(--accent-blue); text-decoration: underline; text-underline-offset: 3px; }
    .article { max-width: 760px; margin: 0 auto; }
    .crumb { font-family: var(--mono); font-size: .78rem; color: var(--muted); margin-bottom: 1.5rem; }
    .crumb a { color: var(--accent-blue); text-decoration: none; }
    .kicker { font-family: var(--mono); color: var(--accent-blue); font-size: .82rem; margin: 0 0 .5rem; }
    .art-head h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0; }
    .lede { color: var(--muted); font-size: 1.1rem; margin: 1rem 0 0; }
    .hero-img { width: 100%; height: auto; border-radius: 12px; margin: 2rem 0; border: 1px solid var(--line); }
    .diagram { margin: 2rem 0; }
    .diagram img { width: 100%; height: auto; display: block; border-radius: 12px; border: 1px solid var(--line); }
    .diagram figcaption { color: var(--muted); font-family: var(--serif); font-size: .9rem; margin-top: .5rem; }
    .byline { font-family: var(--mono); font-size: .8rem; color: var(--muted); margin: 1rem 0 0; }
    .byline time { color: var(--ink); }
    .byline a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
    .byline a:hover { color: var(--ink); }
    .choose { margin: 2rem 0 0; padding: 1.1rem 1.25rem 1.2rem; background: var(--surface);
      border: 1px solid var(--line); border-left: 3px solid var(--accent-amber); border-radius: 10px; }
    .choose h2 { font-size: 1.1rem; margin: 0 0 .75rem; }
    .choose ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .65rem; }
    .choose li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .1rem 1rem; align-items: baseline;
      padding-bottom: .65rem; border-bottom: 1px solid var(--line); }
    .choose li:last-child { border-bottom: 0; padding-bottom: 0; }
    .choose-when { font-family: var(--serif); font-size: 1rem; }
    .choose-pick { font-family: var(--mono); font-weight: 600; color: var(--accent-amber); font-size: .9rem; text-align: right; }
    .choose-why { grid-column: 1 / -1; color: var(--muted); font-family: var(--serif); font-size: .92rem; }
    @media (max-width: 520px) {
      .choose li { grid-template-columns: 1fr; }
      .choose-pick { text-align: left; }
    }
    .keyfacts { margin: 1.5rem 0 0; padding: 1.1rem 1.25rem; background: var(--surface);
      border: 1px solid var(--line); border-left: 3px solid var(--accent-amber); border-radius: 10px; }
    .keyfacts-def { font-family: var(--serif); font-size: 1.12rem; line-height: 1.6; margin: 0; }
    .keyfacts ul { list-style: none; margin: .9rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
    .keyfacts li { display: grid; gap: .2rem; padding-top: .65rem; border-top: 1px solid var(--line); }
    .keyfacts li strong { font-family: var(--mono); font-size: .85rem; color: var(--accent-amber); }
    .keyfacts li span { font-family: var(--serif); font-size: .95rem; color: var(--muted); }
    @media (max-width: 640px) { .keyfacts ul { grid-template-columns: 1fr; } }
    .matrix { margin: 2rem 0 0; padding: 1.1rem 1.25rem 1.2rem; background: var(--surface);
      border: 1px solid var(--line); border-left: 3px solid var(--accent-amber); border-radius: 10px; }
    .matrix h2 { font-size: 1.1rem; margin: 0 0 .75rem; }
    .matrix-scroll { overflow-x: auto; }
    .matrix table { width: 100%; border-collapse: collapse; font-family: var(--serif); font-size: .95rem; min-width: 560px; }
    .matrix th, .matrix td { text-align: left; vertical-align: top; padding: .55rem .6rem; border-bottom: 1px solid var(--line); }
    .matrix thead th { font-family: var(--mono); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    .matrix tbody tr:last-child th, .matrix tbody tr:last-child td { border-bottom: 0; }
    .matrix tbody th { font-weight: 600; }
    .matrix-pick { font-family: var(--mono); font-weight: 600; font-size: .88rem; color: var(--accent-amber); }
    .matrix-note { margin: .75rem 0 0; color: var(--muted); font-family: var(--serif); font-size: .92rem; }
    @media (max-width: 640px) {
      .matrix table, .matrix thead, .matrix tbody, .matrix tr, .matrix th, .matrix td { display: block; min-width: 0; }
      .matrix thead { display: none; }
      .matrix tbody tr { padding: .6rem 0; border-bottom: 1px solid var(--line); }
      .matrix tbody tr:last-child { border-bottom: 0; }
      .matrix tbody th, .matrix td { border: 0; padding: .1rem 0; }
      .matrix td::before { content: attr(data-label) ': '; font-family: var(--mono); font-size: .75rem; color: var(--muted); text-transform: uppercase; }
    }
    .article { --serif: 'Source Serif 4 Variable', Georgia, 'Times New Roman', serif; }
    .lede { font-family: var(--serif); }
    .prose { font-family: var(--serif); font-size: 1.12rem; line-height: 1.7; }
    .prose :global(li), .prose :global(td) { font-family: var(--serif); }
    .faq dd { font-family: var(--serif); }
    .prose :global(h2) { font-size: 1.6rem; margin: 2.5rem 0 .75rem; }
    .prose :global(h3) { font-size: 1.2rem; margin: 1.75rem 0 .5rem; }
    .prose :global(p) { margin: 1rem 0; }
    .prose :global(a) { color: var(--accent-blue); }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; }
    .prose :global(li) { margin: .4rem 0; }
    .prose :global(pre) { background: #0a0c12; border: 1px solid var(--line); border-radius: 10px;
      padding: 1rem 1.25rem; overflow-x: auto; font-family: var(--mono); font-size: .88rem; line-height: 1.6; }
    .prose :global(code) { font-family: var(--mono); font-size: .9em; }
    .prose :global(:not(pre) > code) { background: var(--surface); padding: .1rem .35rem; border-radius: 5px; color: var(--accent-amber); }
    .prose :global(figure) { margin: 2rem 0; }
    .prose :global(figure img) { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); }
    .prose :global(figcaption) { color: var(--muted); font-size: .85rem; margin-top: .5rem; text-align: center; }
    .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: .92rem; }
    .prose :global(th), .prose :global(td) { border: 1px solid var(--line); padding: .55rem .75rem; text-align: left; }
    .prose :global(th) { background: var(--surface); font-family: var(--display); }
    .faq { max-width: 760px; margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--line); }
    .faq h2 { font-size: 1.4rem; margin: 0 0 1rem; }
    .faq dl { margin: 0; }
    .faq-item { margin: 0 0 1.25rem; }
    .faq dt { font-weight: 600; font-size: 1.05rem; margin: 0 0 .35rem; }
    .faq dd { margin: 0; color: var(--muted); }
    .related { max-width: 760px; margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--line); }
    .related h2 { font-size: 1.2rem; font-family: var(--mono); color: var(--accent-blue); margin: 0 0 .75rem; }
    .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
    .related a { color: var(--accent-blue); text-decoration: none; }
    .related a:hover { text-decoration: underline; }
  </style>
</Base>
