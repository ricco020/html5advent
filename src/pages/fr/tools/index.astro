---
import Base from '../../../layouts/Base.astro';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Outils pour la plateforme web',
  url: 'https://html5advent.com/fr/tools',
  description: 'Outils front-end gratuits et interactifs : générateurs CSS visuels et bacs à sable qui tournent entièrement dans votre navigateur.',
};
const tools = [
  { href: '/fr/tools/contrast-checker', title: 'Vérificateur de contraste WCAG', desc: 'Saisissez une couleur de texte et de fond pour obtenir le rapport de contraste et vérifier les niveaux WCAG AA et AAA, en taille normale comme en grande taille.' },
];
---
<Base
  lang="fr"
  title="Outils pour la plateforme web - playgrounds CSS et front-end gratuits"
  description="Outils front-end gratuits et interactifs : générateurs CSS visuels et bacs à sable qui tournent entièrement dans votre navigateur, sans inscription."
  path="tools"
  schema={schema}
>
  <main class="tools-wrap">
    <header class="tools-head">
      <p class="kicker">// tools</p>
      <h1>Outils pour la plateforme web</h1>
      <p class="lede">Des outils front-end gratuits et interactifs qui tournent entièrement dans votre navigateur : rien n'est stocké, aucune inscription. Conçus pour accompagner nos <a href="/fr/guides">guides</a>.</p>
    </header>
    <ul class="tools-list">
      {tools.map((tl) => (
        <li><a href={tl.href}><strong>{tl.title}</strong><span>{tl.desc}</span></a></li>
      ))}
    </ul>
  </main>
  <style>
    .tools-wrap { max-width: 880px; margin: 0 auto; padding: 0 24px; }
    .tools-head .kicker { font-family: var(--mono, monospace); color: var(--accent-blue, #2b6cb0); font-size: .82rem; margin: 0 0 .4rem; }
    .tools-head h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0; }
    .lede { color: var(--muted, #5b5046); font-size: 1.1rem; margin: 1rem 0 2rem; }
    .lede a { color: var(--accent-blue, #2b6cb0); }
    .tools-list { list-style: none; padding: 0; display: grid; gap: 14px; }
    .tools-list a { display: grid; gap: 4px; padding: 18px 20px; border: 1px solid var(--border, #e0d6c6); border-radius: 12px; background: var(--soft, #f4ede1); text-decoration: none; color: var(--ink, #211b17); transition: transform .12s ease, box-shadow .12s ease; }
    .tools-list a:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -12px rgba(0,0,0,.5); }
    .tools-list strong { font-size: 1.15rem; }
    .tools-list span { color: var(--muted, #5b5046); font-size: .95rem; }
  </style>
</Base>
